{
  "name": "krediwall",
  "version": "0.1.0",
  "private": true,
  "description": "Krediwall — high-velocity Credit-on-UPI fraud firewall. Zero-dependency, in-memory transaction evaluation engine targeting sub-5ms verdicts.",
  "license": "Apache-2.0",
  "author": "Kapil",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "test": "jest",
    "typecheck": "tsc -b --pretty",
    "demo": "tsc -b && node examples/demo.mjs",
    "bench": "tsc -b && node --expose-gc benchmarks/run.mjs"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18"
  }
}
